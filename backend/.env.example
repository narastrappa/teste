# Application
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/licitacoes
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/licitacoes

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=licitacoes
MINIO_SECURE=false
AWS_REGION=us-east-1

# Email (aiosmtplib)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# WhatsApp via Z-API
ZAPI_INSTANCE=your-zapi-instance-id
ZAPI_TOKEN=your-zapi-token
ZAPI_BASE_URL=https://api.z-api.io/instances

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Business Rules
IA_SCORE_MIN_ENVIO=70
PRAZO_ALERTA_PROPOSTA_HORAS=24
DIAS_ALERTA_DOCUMENTO=30
SCRAPER_MAX_FALHAS_CONSECUTIVAS=3

# ComprasNet
COMPRASNET_URL=https://comprasnet.gov.br
COMPRASNET_USER=
COMPRASNET_PASS=

# BEC SP
BEC_URL=https://www.bec.sp.gov.br

# Admin email for alerts
ADMIN_EMAIL=admin@example.com
